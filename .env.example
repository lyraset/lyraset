# =============================================================================
# LYRASET — environment variables
#
# Copy to .env (or .env.local for a scratch database) and fill in.
# Never commit a filled-in copy: .env and .env*.local are gitignored.
# =============================================================================

# --- Shared: the public site, the admin CMS and the workspace ----------------

# MongoDB Atlas connection string. The workspace reuses this connection and
# keeps its data in workspace_* collections, so no second database is needed.
# For local development, point at a scratch database rather than production —
# e.g. .../lyraset_ws_dev?retryWrites=true
MONGODB_URI=

# The canonical public URL, used in metadata, sitemaps and notification links.
NEXT_PUBLIC_SITE_URL=https://www.lyraset.com

# --- Admin CMS (next-auth) ---------------------------------------------------

NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Guards the on-demand revalidation endpoint.
REVALIDATE_SECRET=

# --- Cloudinary --------------------------------------------------------------
# Shared with the public site. The workspace uploads HR documents, leave
# certificates, EOD attachments and clock-in selfies as `type: authenticated`,
# so they are never reachable from a guessable URL.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Workspace ---------------------------------------------------------------

# Signs the workspace session cookie (HS256). Must be at least 32 characters;
# 48 random bytes is the recommendation. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WORKSPACE_JWT_SECRET=

# Encrypts national ID numbers (CNIC, Emirates ID) at rest with AES-256-GCM.
# Must be at least 32 characters. Changing it makes existing values unreadable,
# so rotate it only with a migration that re-encrypts them.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKSPACE_FIELD_KEY=

# Bearer token the scheduled jobs authenticate with. Vercel sends this
# automatically to the paths listed in vercel.json. Without it the cron routes
# refuse every request rather than failing open.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Set to exactly "true" to let scripts/seed-workspace.mjs write demo accounts.
# Leave unset in production. The demo passwords are published in that script.
WORKSPACE_ALLOW_SEED=

# --- Email (optional) --------------------------------------------------------
# Without a key the portal still records every notification under the bell;
# only the email copy is skipped.

RESEND_API_KEY=
# Where workspace email is sent from. Must be a verified Resend sender.
WORKSPACE_EMAIL_FROM=LYRASET Workspace <workspace@lyraset.com>
# Public-site lead notifications (unrelated to the workspace).
LEAD_NOTIFY_EMAIL=
