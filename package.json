{
  "name": "lyraset-website",
  "version": "1.0.0",
  "private": true,
  "description": "LYRASET International Marketing Agency \u2014 CMS-driven production website.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "cross-env NEXT_DIST_DIR=.next-check next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,scss,md}\"",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "sync-pages": "node --env-file=.env scripts/sync-pages.mjs",
    "create-admin": "node --env-file=.env scripts/create-admin.mjs",
    "icons": "node scripts/make-icons.mjs",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "tsx --test scripts/test-rbac.mjs scripts/test-cycle.mjs scripts/test-schedule.mjs scripts/test-attendance.mjs scripts/test-leave.mjs",
    "test:rbac": "tsx --test scripts/test-rbac.mjs",
    "seed:workspace": "tsx scripts/seed-workspace.mjs",
    "create-owner": "tsx scripts/create-owner.mjs",
    "test:live": "tsx --test scripts/test-api.mjs scripts/test-flows.mjs scripts/test-rules.mjs",
    "test:all": "npm run test && npm run test:live",
    "icons:workspace": "tsx scripts/make-workspace-icons.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.3",
    "cloudinary": "^2.5.1",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "mongoose": "^8.8.3",
    "next": "^15.1.3",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/bundle-analyzer": "^15.1.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
